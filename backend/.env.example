# Database
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/restaurant_erp?schema=public"

# Auth
JWT_SECRET="change_me_to_a_long_random_string"

# Server
PORT=4000

# --- Email (Resend API recommended for Render, or SMTP) ---
# Resend API (Best for cloud - runs over HTTPS port 443, never blocked)
RESEND_API_KEY=re_123456789
MAIL_FROM=onboarding@resend.dev

# Or Traditional SMTP (may be blocked by Render free tier)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Site Owner seed (used only once, by `npm run seed:site-owner`) ---
# Change these before running against a real production database.
SITE_OWNER_LOGIN_ID=tomsiteowner
SITE_OWNER_PASSWORD=tom_owner
SITE_OWNER_NAME=Site Owner
